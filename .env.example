# ==============================================================================
# VYOMIX Environment Configuration
# Problem Statement: SIH2625 | Indian Army Predictive Logistics
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Variables (Vite - Publicly accessible in browser)
# ------------------------------------------------------------------------------
VITE_APP_NAME="VYOMIX"
VITE_APP_TAGLINE="Predict. Prepare. Deliver."
VITE_DEMO_MODE=true

# Supabase (Public Client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here

# Backend API Endpoint
VITE_BACKEND_API_URL=http://localhost:8000/api

# ------------------------------------------------------------------------------
# Backend Variables (Server-side ONLY - NEVER expose to frontend)
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development

# Supabase Service Key (Server-side bypass for batch ingestion)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Weather Integrations
# IMD Official Endpoint (Mausam API)
IMD_API_BASE_URL=https://mausam.imd.gov.in/api
IMD_API_KEY=

# OpenWeather API (Secondary / Fallback provider)
OPENWEATHER_API_KEY=your_openweather_api_key_optional

# Government Open Data API (data.gov.in)
DATA_GOV_API_KEY=your_data_gov_in_api_key_optional

# ML Engine Configuration
ML_MODEL_TYPE=RandomForest
ML_FORECAST_HORIZON_DAYS=7
ML_CONFIDENCE_THRESHOLD=0.85
